# DevCockpit — variáveis de ambiente
# Copie para .env e ajuste. O .env nunca é versionado.

# --- Servidor ----------------------------------------------------------
# O host é fixado em loopback pelo código. Alterar para 0.0.0.0 faz a
# aplicação recusar subir (NFR-001). Está aqui apenas para explicitar.
DEVCOCKPIT_HOST=127.0.0.1

# 8765 fica fora da faixa comum de dev (3000, 5173, 8000, 8080) para não
# competir com os projetos gerenciados.
DEVCOCKPIT_PORT=8765

DEVCOCKPIT_ENV=development

# --- Banco de dados ----------------------------------------------------
DEVCOCKPIT_DATABASE_URL=sqlite:///./data/devcockpit.db

# --- Log ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
DEVCOCKPIT_LOG_LEVEL=INFO
DEVCOCKPIT_LOG_FILE=./logs/devcockpit.log
DEVCOCKPIT_LOG_FORMAT=json

# --- Configuração ------------------------------------------------------
# Allowlist de diretórios raiz. Fica em arquivo, nunca editável pela API.
DEVCOCKPIT_ROOTS_FILE=./configs/roots.yml
DEVCOCKPIT_DEFAULTS_FILE=./configs/defaults.yml

# --- Cache e polling ---------------------------------------------------
# TTL do cache de leituras rápidas (git status, docker ps), em segundos
DEVCOCKPIT_CACHE_TTL_SECONDS=5

# Intervalo do poller de health check, em segundos
DEVCOCKPIT_HEALTH_POLL_INTERVAL=30

# Timeout de cada health check individual, em segundos
DEVCOCKPIT_HEALTH_TIMEOUT=2

# --- Timeouts de comando (segundos) ------------------------------------
DEVCOCKPIT_TIMEOUT_GIT=10
DEVCOCKPIT_TIMEOUT_DOCKER_READ=15
DEVCOCKPIT_TIMEOUT_COMPOSE_UP=300
DEVCOCKPIT_TIMEOUT_COMPOSE_CONTROL=120
DEVCOCKPIT_TIMEOUT_SYSTEM_ACTION=10
DEVCOCKPIT_TIMEOUT_SCAN=120

# --- Descoberta --------------------------------------------------------
DEVCOCKPIT_SCAN_MAX_DEPTH=3

# --- Jobs --------------------------------------------------------------
# Limite da saída acumulada por job, em bytes
DEVCOCKPIT_JOB_OUTPUT_LIMIT=2097152
# Tempo de retenção de job concluído em memória, em segundos
DEVCOCKPIT_JOB_RETENTION=3600

# --- Retenção de dados -------------------------------------------------
DEVCOCKPIT_HEALTH_HISTORY_DAYS=7
DEVCOCKPIT_ACTIVITY_RETENTION_DAYS=90

# --- Ferramentas externas ----------------------------------------------
# Deixe vazio para resolver pelo PATH. Preencha só se estiver fora dele.
DEVCOCKPIT_GIT_BIN=
DEVCOCKPIT_DOCKER_BIN=
DEVCOCKPIT_CODE_BIN=

# --- Cockpit AI --------------------------------------------------------
# Desligado por padrão. Ligar é um ato fora da interface, de propósito: a
# partir daqui, conteúdo dos seus projetos passa a ser enviado ao provedor.
# Arquivos de segredo (.env, *.key, credenciais) nunca são lidos, e chave que
# aparecer em código sai como [REDIGIDO].
DEVCOCKPIT_AI_ENABLED=false

# anthropic | openai | local | none
# Com "local" (Ollama em 127.0.0.1:11434) nada sai da máquina e não há chave.
#
# Receita do Ollama, do zero:
#   1. instale o Ollama e deixe o aplicativo aberto (ou rode `ollama serve`);
#   2. baixe um modelo: `ollama pull llama3.2:3b`;
#   3. aqui: DEVCOCKPIT_AI_ENABLED=true, PROVIDER=local, MODEL=llama3.2:3b.
# O nome do modelo tem que ser exatamente o que `ollama list` mostra, com a
# etiqueta. Errar o nome dá erro que lista os instalados.
DEVCOCKPIT_AI_PROVIDER=none
DEVCOCKPIT_AI_MODEL=

# Segundo modelo, opcional: o "caprichado" ao lado do rápido. Preenchido, a
# tela do chat mostra um seletor entre os dois; vazio, não mostra nada.
#
# Existe porque num provedor local os dois eixos brigam: um modelo pequeno
# responde dúvida de terminal em segundos e erra em pergunta difícil, um maior
# acerta mais e demora o dobro. Escolher um para sempre é escolher errado
# metade das vezes.
DEVCOCKPIT_AI_MODEL_ALT=

# Só por variável de ambiente. Nunca no banco, nunca devolvida por rota.
DEVCOCKPIT_AI_API_KEY=

# Endereço do provedor. Vazio usa o oficial; serve para proxy ou gateway.
DEVCOCKPIT_AI_BASE_URL=

# Teto de contexto por pergunta e de resposta, em tokens.
DEVCOCKPIT_AI_MAX_CONTEXT_TOKENS=12000
DEVCOCKPIT_AI_MAX_OUTPUT_TOKENS=2000

# Teto de gasto por dia. Zero desliga o teto — desaconselhado: custo invisível
# é o que um dia assusta. Com o provedor local não há custo em dinheiro, mas o
# teto continua útil como medida de uso.
DEVCOCKPIT_AI_DAILY_TOKEN_BUDGET=200000

# Tempo máximo de espera pelo provedor. Modelo local carrega na memória na
# primeira pergunta do dia, e isso pode passar de 120 s numa máquina ocupada.
DEVCOCKPIT_AI_TIMEOUT=120

# Onde este arquivo precisa estar: no aplicativo empacotado, ao lado do
# DevCockpit.exe (a mesma pasta de `data/` e `logs/`). Rodando pelo código, na
# raiz do repositório.

# --- Integração GitHub (Fase 5, não usado no MVP) ----------------------
# Token apenas por variável de ambiente. Nunca no banco, nunca no código.
GITHUB_TOKEN=
